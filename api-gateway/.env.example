# Server
NODE_ENV=development
PORT=3000

# Upstream services
AUTH_SERVICE_URL=http://localhost:4000
APPOINTMENT_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002
PROXY_TIMEOUT_MS=10000

# CORS: * or a comma-separated list of origins (only a list allows cookies)
CORS_ORIGIN=*

# Number of reverse proxies in front of the gateway (0 = none)
TRUST_PROXY=0

# Rate limiting, per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
