# docker compose settings: copy to .env and fill in every empty value.
# docker compose refuses to start while a required secret is missing.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The services reject JWT secrets shorter than 32 characters in production.

# Published port of the api-gateway
GATEWAY_PORT=3000

# Published port of the web UI (nginx)
WEB_PORT=8080
# Gateway address baked into the web UI's bundle at build time. Only change
# this if the gateway is reachable at a different host/port than the browser
# uses to open the web UI (e.g. GATEWAY_PORT was changed, or deploying
# somewhere other than localhost).
WEB_API_BASE_URL=http://localhost:3000

# JWT (required). auth-service signs access tokens with this; the other
# services verify them with the same JWT_ACCESS_SECRET. Refresh tokens are
# opaque (not JWTs) and only ever live hashed in auth-service's own database;
# JWT_REFRESH_EXPIRES_IN just sets how long a refresh token stays valid.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Shared secret for service-to-service calls (required): right now just
# notification-service asking auth-service for a recipient's e-mail address.
INTERNAL_SERVICE_TOKEN=

# Outgoing e-mail (verification/password-reset, appointment notifications).
# Defaults point at the mailhog container, which catches everything sent in
# development without delivering it anywhere - open http://localhost:8025.
SMTP_FROM=Randevia <no-reply@randevia.local>

# Bootstrap admin (password required, 8-72 characters). auth-service creates
# this account on startup and re-applies the password on every start, so
# changing it here and restarting rotates it.
ADMIN_EMAIL=admin@randevia.local
ADMIN_PASSWORD=
ADMIN_NAME=Randevia Admin

# RabbitMQ (only applied when its volume is first created)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# api-gateway
# Must be the web UI's exact origin (not *): the login/refresh cookie and the
# Socket.io connection both need credentials, which browsers only allow for a
# listed origin. Comma-separate if the web UI is reachable at more than one
# (e.g. the Vite dev server during development).
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
