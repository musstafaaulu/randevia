# docker compose settings. Copy to .env and change the secrets for anything
# beyond local development; every value has a development default.

# Published port of the api-gateway
GATEWAY_PORT=3000

# JWT (shared by all services: auth-service signs, the others verify)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap admin, created by auth-service on startup
ADMIN_EMAIL=admin@randevia.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Randevia Admin

# RabbitMQ (only applied when its volume is first created)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# api-gateway
CORS_ORIGIN=*
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
