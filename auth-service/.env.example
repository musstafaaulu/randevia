# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/randevia_auth

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (at least 32 characters when NODE_ENV=production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Shared secret for service-to-service calls (notification-service looking
# up a recipient's e-mail address via GET /api/v1/auth/internal/users/:id)
INTERNAL_SERVICE_TOKEN=

# Outgoing e-mail (verification/password-reset). Defaults match a local
# mailhog container (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Randevia <no-reply@randevia.local>
WEB_BASE_URL=http://localhost:8080

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# CORS
CORS_ORIGIN=*

# Reverse proxies in front of this service (set to 1 behind the api-gateway)
TRUST_PROXY=0

# Logging
LOG_LEVEL=info

# Bootstrap admin (optional). Self-registration only creates patients; this
# admin assigns the doctor role via PATCH /api/v1/auth/users/:id/role.
ADMIN_EMAIL=admin@randevia.local
ADMIN_PASSWORD=
ADMIN_NAME=Randevia Admin
