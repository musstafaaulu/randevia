# Server
NODE_ENV=development
PORT=4002

# MongoDB
MONGO_URI=mongodb://localhost:27017/randevia_notification

# JWT (must match auth-service's JWT_ACCESS_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (at least 32 characters when NODE_ENV=production)
JWT_ACCESS_SECRET=

# Redis (Socket.io adapter, for running more than one instance; optional for
# a single instance - the service falls back to in-memory if it can't connect)
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=randevia.events
NOTIFICATION_QUEUE=notification-service.appointment-events
RABBITMQ_PREFETCH=10
# Transient failures are retried this many times, MESSAGE_RETRY_DELAY_MS apart,
# before the message is moved to the dead-letter queue.
MESSAGE_MAX_RETRIES=3
MESSAGE_RETRY_DELAY_MS=5000

# Notifications
NOTIFICATION_TIMEZONE=Europe/Istanbul

# Outgoing e-mail for appointment notifications. Defaults match a local
# mailhog container (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Randevia <no-reply@randevia.local>

# auth-service's internal endpoint for resolving a recipient's e-mail
# address, and the shared secret that guards it (must match auth-service's
# INTERNAL_SERVICE_TOKEN).
AUTH_SERVICE_URL=http://localhost:4000
INTERNAL_SERVICE_TOKEN=

# CORS
CORS_ORIGIN=*

# Reverse proxies in front of this service (set to 1 behind the api-gateway)
TRUST_PROXY=0

# Logging
LOG_LEVEL=info
